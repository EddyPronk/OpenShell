# The supervisor image: upstream's deploy/docker/Dockerfile.supervisor with the
# binary built by Containerfile, for the machine podman runs on.
#
# Build context: the directory holding the built openshell-supervisor.
ARG SUPERVISOR_BASE_IMAGE=gcr.io/distroless/base-nossl-debian13@sha256:af5cb8dd589b8520b8c06bebb9efb73d7e16406cab58e85c51761fff49d370a0
FROM ${SUPERVISOR_BASE_IMAGE}
COPY --chmod=0555 openshell-supervisor /openshell-supervisor
ENTRYPOINT ["/openshell-supervisor"]
